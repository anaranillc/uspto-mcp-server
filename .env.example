# Copy to .env and fill in your keys. NEVER commit the real .env file.
# .env is gitignored.

# Required: USPTO API key from https://developer.uspto.gov
# Used for the ODP (api.uspto.gov) and TSDR endpoints.
USPTO_API_KEY=

# Optional: PatentsView API key (supplementary granted-patent enrichment).
# Note: PatentsView is winding down and no longer issuing new keys; leave blank if unused.
PATENTSVIEW_API_KEY=
